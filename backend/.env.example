# 服务
BACKEND_HOST=127.0.0.1
PORT=8000
APP_NAME=Memora
DATA_DIR=./data
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 用户认证与手机验证码登录。生产环境必须设置高强度 AUTH_SECRET，并配置短信 Webhook。
AUTH_ENABLED=true
AUTH_SECRET=
AUTH_SESSION_DAYS=30
AUTH_COOKIE_SECURE=false
SMS_CODE_TTL_SECONDS=300
SMS_CODE_COOLDOWN_SECONDS=60
SMS_CODE_MAX_ATTEMPTS=5
# Webhook 接收 JSON：{"phone":"...","code":"123456","expiresIn":300}
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# 仅限本地开发：验证码会随发送接口响应返回，生产环境必须为 false。
SMS_DEBUG_CODE=true

# 阿里云百炼千问 OpenAI 兼容接口（未配置时使用本地降级逻辑）
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# 外部 Provider 统一可靠性策略（LLM、Embedding、Rerank、搜索、OCR、腾讯会议、AgentMail、SMTP）
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_BACKOFF_SECONDS=0.5
PROVIDER_CIRCUIT_THRESHOLD=5
PROVIDER_CIRCUIT_SECONDS=30

# 可选：混合检索语义向量。默认复用 LLM Key 和地址；未配置 Key 时自动使用 FTS5。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=0

# 可选：检索结果模型重排。默认复用 LLM Key；需要配合 Rerank 服务接入后生效。
RERANK_API_KEY=
RERANK_API_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_MODEL=gte-rerank-v2
RERANK_TOP_N=8

# 上下文 Token 预算
HISTORY_TOKEN_BUDGET=3200
DOCUMENT_TOKEN_BUDGET=7000
MEMORY_TOKEN_BUDGET=1200
WEB_TOKEN_BUDGET=2200

# 可选：扫描 PDF OCR 服务，接收 multipart file，返回 {pages:[{page_number,text}]}。
OCR_API_URL=
OCR_API_KEY=

# Tavily 搜索（未配置时使用 DuckDuckGo 即时答案）
TAVILY_API_KEY=

# 可选：腾讯会议官方 MCP。Token 从 https://meeting.tencent.com/ai-skill/ 获取。
# Token 仅保存在后端环境变量中，不要提交到 Git 或发送到浏览器。
TENCENT_MEETING_TOKEN=
TENCENT_MEETING_MCP_URL=https://mcp.meeting.tencent.com/mcp/wemeet-open/v1
TENCENT_MEETING_SKILL_VERSION=v1.0.14
TENCENT_MEETING_TIMEOUT_SECONDS=30

# AgentMail 系统邮箱。配置 API Key 后，用户无需提供个人邮箱授权码。
# INBOX_ID 可选；留空时首次发送会自动创建并持久化邮箱地址。
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
AGENTMAIL_BASE_URL=https://api.agentmail.to/v0

# 可选备用：个人 SMTP 邮件。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 可选：生产环境建议设置，用于加密前端保存的 SMTP 配置。
# 留空时会自动在 DATA_DIR 下生成 .settings.key。
SETTINGS_ENCRYPTION_KEY=
