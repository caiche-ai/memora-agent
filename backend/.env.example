# 服务
BACKEND_HOST=127.0.0.1
PORT=8000
APP_NAME=Memora
DATA_DIR=./data
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 阿里云百炼千问 OpenAI 兼容接口（未配置时使用本地降级逻辑）
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# 外部 Provider 统一可靠性策略（LLM、Embedding、搜索、OCR、AgentMail、SMTP）
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_BACKOFF_SECONDS=0.5
PROVIDER_CIRCUIT_THRESHOLD=5
PROVIDER_CIRCUIT_SECONDS=30

# 可选：混合检索语义向量。默认复用 LLM Key 和地址；未配置 Key 时自动使用 FTS5。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=0

# 上下文 Token 预算
HISTORY_TOKEN_BUDGET=3200
DOCUMENT_TOKEN_BUDGET=7000
MEMORY_TOKEN_BUDGET=1200
WEB_TOKEN_BUDGET=2200

# 可选：扫描 PDF OCR 服务，接收 multipart file，返回 {pages:[{page_number,text}]}。
OCR_API_URL=
OCR_API_KEY=

# Tavily 搜索（未配置时使用 DuckDuckGo 即时答案）
TAVILY_API_KEY=

# AgentMail 系统邮箱。配置 API Key 后，用户无需提供个人邮箱授权码。
# INBOX_ID 可选；留空时首次发送会自动创建并持久化邮箱地址。
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
AGENTMAIL_BASE_URL=https://api.agentmail.to/v0

# 可选备用：个人 SMTP 邮件。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 可选：生产环境建议设置，用于加密前端保存的 SMTP 配置。
# 留空时会自动在 DATA_DIR 下生成 .settings.key。
SETTINGS_ENCRYPTION_KEY=
